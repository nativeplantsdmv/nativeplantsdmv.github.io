---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
}

const siteTitle = 'NativePlantsDMV.com';
const siteUrl = 'https://nativeplantsdmv.com';
const defaultImage = `${siteUrl}/images/butterfly-coneflowers.jpg`;
const { title, description } = Astro.props;
const pageTitle = title === 'Home' ? siteTitle : `${title} | ${siteTitle}`;
const pageDesc = description || 'Native plant resources for the DC Metro area (DMV) - nurseries, events, organizations, and guides.';
const canonicalUrl = Astro.url.href;
---

<html lang="en" class="bg-stone-50">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={pageDesc} />
  <link rel="canonical" href={canonicalUrl} />

  <!-- Open Graph -->
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDesc} />
  <meta property="og:image" content={defaultImage} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:type" content="website" />

  <!-- Twitter Cards -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={pageDesc} />
  <meta name="twitter:image" content={defaultImage} />

  <title>{pageTitle}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" define:vars={{url: canonicalUrl}}>
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "NativePlantsDMV.com",
    "url": "{url}",
    "description": "Native plant resources for the DC Metro area (DMV). Nurseries, plant swaps, landscaping companies, and everything you need to grow a garden that supports wildlife.",
    "logo": "{url}/images/site-logo.jpg",
    "email": "mailto:kallen808@gmail.com"
  }
  </script>
</head>
<body class="flex flex-col min-h-screen">
  <Header title={siteTitle} currentPage={title} />

  <main class="flex-grow py-8 sm:py-12">
    <slot />
  </main>

  <Footer />

  <!-- Mobile menu toggle -->
  <script is:inline>
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    if (btn && menu) {
      btn.addEventListener('click', () => {
        const expanded = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!expanded));
        menu.classList.toggle('hidden');
      });
    }
  </script>
</body>
</html>
