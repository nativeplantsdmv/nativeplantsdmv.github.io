---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
}

const siteTitle = 'NativePlantsDMV.com';
const { title, description } = Astro.props;
const pageTitle = title === 'Home' ? siteTitle : `${title} | ${siteTitle}`;
---

<html lang="en" class="bg-stone-50">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description || 'Native plant resources for the DC Metro area (DMV) - nurseries, events, organizations, and guides.'} />
  <title>{pageTitle}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body class="flex flex-col min-h-screen">
  <Header title={siteTitle} currentPage={title} />

  <main class="flex-grow container-narrow py-8 sm:py-12">
    <slot />
  </main>

  <Footer />
</body>
</html>
