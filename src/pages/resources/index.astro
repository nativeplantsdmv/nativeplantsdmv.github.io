---
import PageLayout from '../../layouts/PageLayout.astro';
import { organizations } from '../../lib/organizations';
---

<PageLayout title="Resources" description="Reference guides, plant identification apps, organizations, and educational resources for native gardening in the DC Metro area.">

<!-- Why Native Plants -->
<section class="section bg-white">
  <div class="container-narrow">
    <h2 class="section-title flex items-center gap-3">
      <span class="text-3xl">🦋</span> Why Grow Native Plants?
    </h2>
    <p class="text-gray-600 mb-6">Many groups have answered this question far better than I could:</p>

    <div class="grid gap-4 max-w-3xl">
      <a href="https://www.audubon.org/content/why-native-plants-matter" target="_blank" rel="noopener" class="resource-link">
        Audubon: Why Native Plants Matter
      </a>
      <a href="https://tpss.coop/pro-pollinator-butterflies-and-their-host-plants" target="_blank" rel="noopener" class="resource-link">
        Pro-Pollinator: Butterflies and Their Host Plants <span class="text-sm text-gray-500">(written by two CAC members)</span>
      </a>
      <a href="https://www.sierraclub.org/maryland/blog/2019/04/improve-your-garden-native-plants" target="_blank" rel="noopener" class="resource-link">
        Sierra Club Maryland: Improve Your Garden with Native Plants
      </a>
      <a href="https://www.yesmagazine.org/environment/2020/02/07/yard-sustainability-native-plants" target="_blank" rel="noopener" class="resource-link">
        YES! Magazine: Yard Sustainability through Native Plants
      </a>
      <a href="https://louisville.wildones.org/2025/08/13/soft-landings-how-to-enhance-butterfly-and-moth-survival-under-trees/" target="_blank" rel="noopener" class="resource-link">
        Soft Landings: How to Enhance Butterfly and Moth Survival Under Trees
      </a>
      <a href="https://www.humanesociety.org/news/wildlife-garden-myths" target="_blank" rel="noopener" class="resource-link">
        Humane Society: Wildlife Garden Myths
      </a>
      <a href="https://www.washingtonpost.com/opinions/interactive/2022/climate-change-backyard-gardening-permaculture-fall/" target="_blank" rel="noopener" class="resource-link">
        Washington Post: Climate Change, Backyard Gardening & Permaculture
      </a>
    </div>

    <div class="mt-6 p-4 bg-green-50 rounded-lg border border-green-200 max-w-3xl">
      <p class="text-gray-700 mb-2"><strong>Recommended Video:</strong> Doug Tallamy explains the importance of natives.</p>
      <a href="https://www.youtube.com/watch?v=w39g_f7BMUk" target="_blank" rel="noopener" class="resource-link">
        Watch on YouTube
      </a>
    </div>

    <div class="mt-8 flex justify-center">
      <img
        src="/images/coreopsis-bees.jpg"
        alt="Coreopsis flowers hosting bees"
        class="rounded-xl shadow-lg w-full max-w-xl"
        loading="lazy"
      />
    </div>
  </div>
</section>

<!-- Plant ID Apps -->
<section class="section bg-stone-50">
  <div class="container-narrow">
    <h2 class="section-title flex items-center gap-3">
      <span class="text-3xl">📱</span> Plant Identification Apps for Your Phone
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-3xl">
      {[
        {
          name: 'Picture This',
          desc: 'Take a picture of any plant and get the name, plus lots of other information. Scroll down to map to see if it is native to eastern US.',
          price: '$30/year',
          ios: 'https://apps.apple.com/us/app/picturethis-plant-identifier/id1252497129',
          android: 'https://play.google.com/store/apps/details?id=cn.danatech.xingseus&hl=en-US'
        },
        {
          name: 'Seek',
          desc: 'Get plant (or bug) in focus to light up 7 dots. When all are lit you have identified your subject. Click photo to learn more about that plant. The "kid" version of iNaturalist.',
          price: 'Free',
          ios: 'https://apps.apple.com/us/app/seek-by-inaturalist/id1353224144',
          android: 'https://play.google.com/store/apps/details?id=org.inaturalist.seek&hl=en-US'
        },
        {
          name: 'iNaturalist',
          desc: 'Several steps for ID, but used worldwide for scientific study.',
          price: 'Free',
          ios: 'https://apps.apple.com/us/app/inaturalist/id6475737561',
          android: 'https://play.google.com/store/apps/details?id=org.inaturalist.android&hl=en-US'
        },
        {
          name: 'Google Lens',
          desc: 'Part of the Google suite: take a picture and identify anything &mdash; plants, animals, furniture, etc.',
          price: 'Free',
          android: 'https://play.google.com/store/apps/details?id=com.google.ar.lens&hl=en-US'
        },
      ].map(app => (
        <div class="card">
          <h3 class="font-bold text-green-800">{app.name}</h3>
          <p class="text-gray-700 text-sm mt-1">{app.desc}</p>
          <span class={`inline-block mt-2 text-xs font-medium px-2 py-1 rounded-full ${app.price === 'Free' ? 'bg-green-100 text-green-700' : 'bg-stone-100 text-stone-600'}`}>
            {app.price}
          </span>
          <div class="mt-2 flex gap-2">
            {app.ios && (
              <a href={app.ios} target="_blank" rel="noopener" class="text-xs text-gray-500 hover:text-green-700 transition-colors flex items-center gap-1">
                <svg class="w-3.5 h-3.5 flex-shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
                App Store
              </a>
            )}
            {app.android && (
              <a href={app.android} target="_blank" rel="noopener" class="text-xs text-gray-500 hover:text-green-700 transition-colors flex items-center gap-1">
                <svg class="w-3.5 h-3.5 flex-shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3.609 1.814L13.792 12 3.61 22.186a.996.996 0 0 1-.61-.92V2.734a1 1 0 0 1 .609-.92zm10.89 10.893l2.302 2.302-10.937 6.333 8.635-8.635zm3.199-3.199l2.807 1.626a1 1 0 0 1 0 1.732l-2.807 1.626L15.206 12l2.492-2.492zM5.864 2.658L16.8 8.99l-2.302 2.302-8.634-8.634z"/></svg>
                Google Play
              </a>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Garden Design Resources -->
<section id="garden-design" class="section bg-white">
  <div class="container-narrow">
    <h2 class="section-title flex items-center gap-3">
      <span class="text-3xl">🌿</span> Free Garden Design Resources
    </h2>
    <p class="text-gray-600 mb-6">Whether you're starting from scratch or expanding an existing bed, these guides and tools will help you plan a garden that works for your space and supports local wildlife.</p>

    <!-- Featured resources with images -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 max-w-3xl mb-8">
      <a href="https://nativegardendesigns.wildones.org/designs/washington-dc/" target="_blank" rel="noopener" class="block rounded-lg border border-gray-200 overflow-hidden hover:border-green-400 transition-colors group">
        <img src="/images/wild-ones-designs.png" alt="DC area native garden design plan with plant placement zones" class="w-full h-auto object-cover aspect-video" loading="lazy"/>
        <div class="p-4 bg-stone-50">
          <span class="text-sm font-semibold text-green-800 group-hover:underline block">Wild Ones: DC Area Native Garden Design</span>
          <p class="text-gray-600 text-xs mt-1">A curated design by Larry Weaner with 21 native species, plant list, and methodology. Covers three ecozones relevant to the DC region.</p>
        </div>
      </a>
      <a href="https://www.howardnature.org/wp-content/uploads/2020/05/Native-Plant-Pollinator-Garden-Templates.pdf" target="_blank" rel="noopener" class="block rounded-lg border border-gray-200 overflow-hidden hover:border-green-400 transition-colors group">
        <img src="/images/bumblebee-on-native.png" alt="Bumblebees foraging on Joe-Pye Weed flowers" class="w-full h-auto object-cover aspect-video" loading="lazy"/>
        <div class="p-4 bg-stone-50">
          <span class="text-sm font-semibold text-green-800 group-hover:underline block">Howard Nature: Pollinator Garden Templates</span>
          <p class="text-gray-600 text-xs mt-1">Four downloadable layout templates for different conditions (sunny/dry, sunny/moist, part sun/dry, part sun/moist) with plant counts and bloom timelines. Maryland-specific.</p>
        </div>
      </a>
    </div>

    <!-- Additional resources as links -->
    <div class="grid gap-3 max-w-3xl">
      <a href="https://nativegardendesigns.wildones.org/designs/" target="_blank" rel="noopener" class="resource-link">
        Wild Ones: Native Garden Designs — All Locations
      </a>
      <p class="text-gray-500 text-xs -mt-2 ml-4">15+ metro areas nationwide with curated native plant palettes.</p>
      <a href="https://www.pollinator-pathway.org/native-garden-designs" target="_blank" rel="noopener" class="resource-link">
        Pollinator Pathway: Native Garden Designs
      </a>
      <p class="text-gray-500 text-xs -mt-2 ml-4">Northeast restoration guides and planting toolkits, including small yard and container strategies.</p>
      <a href="https://wildpollinators-pollinisateurssauvages.ca/2024/06/06/beginner-pollinator-garden-the-3-x-3-x-3-system/" target="_blank" rel="noopener" class="resource-link">
        Beginner Pollinator Garden: The 3 × 3 × 3 System
      </a>
      <p class="text-gray-500 text-xs -mt-2 ml-4">Simple framework: 3 spring bloomers, 3 summer, 3 late-season — plant 3 of each in an 8×4 ft bed.</p>
      <a href="https://www.nativegardenplanner.com/" target="_blank" rel="noopener" class="resource-link">
        Native Garden Planner
      </a>
      <p class="text-gray-500 text-xs -mt-2 ml-4">Drag-and-drop planner with a database of 2,000+ native species and PDF export. Paid service.</p>
      <a href="https://www.blazingstargardens.com/design-a-native-pollinator-garden-tool" target="_blank" rel="noopener" class="resource-link">
        Blazing Star Gardens: Design a Pollinator Garden Tool
      </a>
      <p class="text-gray-500 text-xs -mt-2 ml-4">Free drag-and-drop Google Slides tool with illustrated plant graphics. Desktop only.</p>
      <a href="https://www.fws.gov/story/how-build-pollinator-garden" target="_blank" rel="noopener" class="resource-link">
        FWS: How to Build a Pollinator Garden
      </a>
      <p class="text-gray-500 text-xs -mt-2 ml-4">US Fish & Wildlife Service guide covering planning, planting, and maintenance at any scale.</p>
    </div>
  </div>
</section>
<!-- Organizations -->
<section id="organizations" class="section bg-white">
  <div class="container-narrow">
    <h2 class="section-title flex items-center gap-3">
      <span class="text-3xl">🤝</span> Organizations That Promote Native Plants
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 max-w-3xl">
      {organizations.map(org => (
        <div class="card text-center">
          <h3 class="font-bold text-green-800">{org.name}</h3>
          <a href={org.url} target="_blank" rel="noopener" class="resource-link text-sm block mt-1">{org.url}</a>
          {org.sub && (org.subUrl ? <p class="text-gray-600 text-xs mt-2">{org.sub}: <a href={org.subUrl} target="_blank" rel="noopener" class="resource-link">{org.subUrl}</a></p> : <p class="text-gray-600 text-xs mt-2 italic">{org.sub}</p>)}
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Leave the Leaves -->
<section class="section bg-stone-50">
  <div class="container-narrow">
    <h2 class="section-title flex items-center gap-3">
      <span class="text-3xl">🍂</span> Why You Should Leave the Leaves
    </h2>

    <p class="text-gray-600 mb-6">Leaving leaf litter over winter protects beneficial insects, adds organic matter to your soil, and requires less work in spring. Here are some references:</p>

    <div class="grid gap-4 max-w-3xl">
      {[
        { title: 'Montgomery County MD: Tips on Leaving Leaves', url: 'https://www.montgomerycountymd.gov/DEP/property-care/lawns/tips/leaves.html' },
        { title: 'How To Preserve Beneficial Hibernating Insects in Your Yard (UMD)', url: 'https://cmns.umd.edu/news-events/news/max-ferlauto-karin-burghardt-how-preserve-beneficial-hibernating-insects-your-yard' },
        { title: 'Doug Tallamy Explains Why (and How to) Leave the Leaves (Gardenista)', url: 'https://www.gardenista.com/posts/ask-expert-doug-tallamy-leave-leaves/' },
        { title: 'Leave the Leaves: Winter Habitat Protection (Xerces Society)', url: 'https://xerces.org/leave-the-leaves' },
        { title: 'Leave the Leaves & Plant Debris - Support Insects (YouTube)', url: 'https://www.youtube.com/watch?v=vCjzcN_7JAU' },
        { title: 'Eco-Conscious Spring and Fall Garden Cleanup (Anacostia River Watershed Society)', url: 'https://www.anacostiaws.org/blog/leave-the-leaves.html' },
        { title: 'Xerces Blog: Leave the Leaves', url: 'https://xerces.org/blog/leave-the-leaves' },
        { title: 'When Should You Rake Up Your Leaves in Spring? (FONTT)', url: 'https://fontt.org/hold-off-on-your-yards-spring-clean-up/' },
        { title: "Don't Spring Into Garden Cleanup Too Soon (Xerces)", url: 'https://xerces.org/blog/dont-spring-into-garden-cleanup-too-soon' },
        { title: '5 Tips On Leaving The Fall Leaves (YouTube)', url: 'https://www.youtube.com/watch?v=HvyPGCmx6ts' },
        { title: 'Pro-Tips for Leaving the Leaves (National Wildlife Federation)', url: 'https://blog.nwf.org/2023/10/pro-tips-for-leaving-the-leaves/' },
        { title: 'Washington Post: Why You Should Be Lazy and Leave Your Leaves', url: 'https://www.washingtonpost.com/climate-solutions/2023/10/14/raking-leaves-yard-fall-environment/' },
      ].map(item => (
        <div class="nursery-entry">
          <a href={item.url} target="_blank" rel="noopener" class="resource-link">{item.title}</a>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- What Native Plants Are Good For Your Yard -->
<section class="section bg-white">
  <div class="container-narrow">
    <h2 class="section-title flex items-center gap-3">
      <span class="text-3xl">&#127809;</span> What Native Plants Are Good for Your Yard?
    </h2>
    <div class="grid gap-4 max-w-3xl mt-6">
      {[
        {
          title: 'Piedmont Region: Maryland Native Plant Guide book',
          url: 'https://mdflora.org/Sys/Store/Products/404087',
          image: '/images/piedmont-guide-cover.png',
        },
        { title: 'Native Plants for Shady Slopes', url: 'https://extension.umd.edu/resource/native-plants-shady-slopes' },
        { title: 'Native Plants for Sunny Slopes', url: 'https://extension.umd.edu/resource/native-plants-sunny-slopes' },
        { title: 'Regional Native Plant Vendors (Retail and Wholesale)', url: 'https://mdflora.org/nurseries.html' },
        { title: 'Rainscapes Plants Guide (Montgomery County, MD)', url: 'https://www.sierraclub.org/sites/www.sierraclub.org/files/sce/maryland-chapter/Campaigns/Natural_Places/Native%20Plants%20Shrubs%20Sunny%20Shade%20Invasives%20Deer%20Resistant%20-%20Copy.pdf' },
        { title: 'Recommended Native Plants for Maryland', url: 'https://extension.umd.edu/resource/recommended-native-plants-maryland' },
        { title: 'Native Plant Top 10 Lists (grownative.org)', url: 'https://grownative.org/learn/top-10-lists/' },
        { title: 'Gardening with Natives in Wet Areas', url: 'https://piedmontmastergardeners.org/article/gardening-with-natives-in-wet-areas/' },
        { title: 'Top 5 Groundcover Plants (My Green Montgomery)', url: 'https://mygreenmontgomery.org/2025/top-5-groundcover-plants/' },
        { title: 'Shrubs and the Pollinators Who Love Them (Harvard)', url: 'https://arboretum.harvard.edu/stories/shrubs-and-the-pollinators-who-love-them/' },
        { title: 'Maryland Natives Spreadsheet (moisture, sun, soil, size, etc.)', url: 'https://docs.google.com/spreadsheets/d/1G4eoUbqfp0M8vwNd-EsgVHB0ISrO0350v-0NwbGdKPQ/edit?usp=sharing' },
        { title: 'Friends of Native Trees Takoma (FONTT) - Tree Guide', url: 'https://fontt.org/please-download-our-guide/takoma-park-native-tree-selection-guide/' },
        { title: 'Pollinator Plants: Mid Atlantic Region (PDF)', url: 'https://extension.umd.edu/sites/extension.umd.edu/files/2021-03/FC-MGPub%20Pollinator%20Plants%20Mid-Atlantic%20Region.pdf' },
      ].map(item => (
        <div class="nursery-entry" style="overflow: hidden;">
          {item.image ? (
            <img src={item.image} alt="" class="float-right ml-4 w-20 h-28 rounded object-cover" />
          ) : null}
          <a href={item.url} target="_blank" rel="noopener" class="resource-link block">{item.title}</a>
        </div>
      ))}
    </div>

  </div>
</section>

</PageLayout>
