---
import PageLayout from '../../layouts/PageLayout.astro';
import { events, recurringActivities } from '../../lib/data';
import { serializePortableText } from '../../lib/portabletext';

// Helper to format date components for the calendar badge
function formatDateBadge(dateStr: string): { month: string, day: number } {
  const d = new Date(dateStr);
  return {
    month: d.toLocaleDateString('en-US', { month: 'short' }).toUpperCase(),
    day: d.getDate(),
  };
}

function formatTime(dateStr: string): string {
  const d = new Date(dateStr);
  return d.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' }).replace(':00', '');
}

const noteColors: Record<string, string> = {
  amber: 'bg-amber-50 border-amber-200 text-amber-800',
  green: 'bg-green-50 border-green-200 text-green-800',
};

// Render Portable Text or fallback to plain text (for legacy data)
function renderDescription(desc: any): string {
  if (Array.isArray(desc)) {
    return serializePortableText(desc);
  }
  if (typeof desc === 'string') {
    // Legacy plain text - convert newlines to <br>
    return desc.replace(/\n/g, '<br/>');
  }
  return '';
}

function renderNoteContent(note: any): string {
  if (Array.isArray(note)) {
    return serializePortableText(note);
  }
  if (typeof note === 'string') {
    return note.replace(/\n/g, '<br/>');
  }
  return '';
}
---

<PageLayout title="Current Events" description="Native plant exchanges, swaps, and events in the DC Metro area. Spring 2026 schedule and upcoming activities.">

<!-- Hero -->
<section class="relative bg-gradient-to-b from-teal-700 to-teal-600 text-white -mt-8 pt-8 pb-12 sm:pb-16 rounded-b-3xl sm:mx-auto max-w-6xl">
  <div class="container-narrow">
    <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-center mb-6">Current Events</h1>
    <p class="text-xl text-teal-100 text-center max-w-2xl mx-auto">
      Native plant exchanges, swaps, and community events in the DC Metro area.
    </p>
  </div>
</section>

<!-- Events -->
<section class="section bg-white">
  <div class="container-narrow max-w-3xl mx-auto">
    <h2 class="section-title text-center">Native Plant Exchanges &mdash; {events.length ? new Date(events[0].dateStart).getFullYear() : new Date().getFullYear()} Season</h2>

    <div class="space-y-6">
      {events.length ? events.map((event) => {
        const badge = formatDateBadge(event.dateStart);
        const times = formatTime(event.dateStart);
        const noteClass = event.noteType ? noteColors[event.noteType] : null;
        const descriptionHtml = renderDescription(event.description);
        const noteHtml = renderNoteContent(event.noteContent);

        return (
          <article class="event-card">
            <div class="flex flex-col sm:flex-row gap-6">
              <div class="flex-1">
                <div class="flex items-start gap-4 mb-3">
                  <div class="bg-green-600 text-white rounded-lg w-16 h-16 flex flex-col items-center justify-center flex-shrink-0 shadow-md">
                    <span class="text-xs font-bold uppercase leading-tight">{badge.month}</span>
                    <span class="text-xl font-extrabold leading-none">{badge.day}</span>
                  </div>
                  <div>
                    <h3 class="text-xl font-bold text-green-800">{event.title}</h3>
                    {event.venue && <p class="text-gray-600 mt-1"><strong>{event.venue}</strong></p>}
                  </div>
                </div>

                <div class="space-y-2 text-gray-700">
                  <div class="flex items-center gap-2">
                    <svg class="w-5 h-5 text-green-600 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" strokeWidth="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    <span><strong>{times}</strong></span>
                  </div>
                  {event.address && (
                    <div class="flex items-center gap-2">
                      <svg class="w-5 h-5 text-green-600 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" strokeWidth="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" strokeWidth="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                      <span>{event.address}</span>
                    </div>
                  )}
                </div>

                {noteClass && noteHtml && (
                  <div class={`${noteClass} border rounded-lg p-4 mt-4`}>
                    <p set:html={noteHtml} />
                  </div>
                )}

                {descriptionHtml && !event.noteType && (
                  <div class="space-y-2 text-gray-700 mt-4" set:html={descriptionHtml} />
                )}

                {event.hosts && (
                  <p class="text-gray-600 text-sm mt-4">Hosted by <strong>{event.hosts}</strong>.</p>
                )}
              </div>

              {event.imageAsset && (
                <div class="flex-shrink-0 hidden sm:block">
                  <img
                    src={event.imageAsset.url ?? ''}
                    alt={event.title}
                    class="rounded-xl shadow-lg w-48 h-auto object-cover"
                    loading="lazy"
                  />
                </div>
              )}
            </div>
          </article>
        );
      }) : <p class="text-gray-500 text-center italic">More coming soon!</p>}
    </div>

    <!-- Plant exchange photo -->
    <div class="mt-8 text-center sm:hidden">
      <img
        src="/images/plant-swap-photo.jpg"
        alt="Plant swap event with people exchanging native plants"
        class="rounded-xl shadow-lg w-full max-w-md mx-auto"
        loading="lazy"
      />
    </div>

    <div class="mt-8 text-center">
      <img
        src="/images/plant-exchange-spring.jpg"
        alt="Spring plant exchange event"
        class="rounded-xl shadow-lg w-full max-w-md mx-auto"
        loading="lazy"
      />
    </div>
  </div>
</section>

<!-- Recurring Activities -->
<section class="section bg-stone-50">
  <div class="container-narrow max-w-3xl mx-auto">
    <h2 class="section-title text-center">Recurring Activities</h2>

    <div class="grid gap-4">
      {recurringActivities.map((activity) => (
        <div class="card">
          <h3 class="font-bold text-green-800 text-lg">{activity.title}</h3>
          {(Array.isArray(activity.body)) ? (
            <div class="text-gray-700 mt-2" set:html={serializePortableText(activity.body)} />
          ) : (
            <p class="text-gray-700 mt-2 whitespace-pre-line">{activity.body || ''}</p>
          )}
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Contact -->
<section class="section bg-green-50">
  <div class="container-narrow text-center max-w-xl mx-auto">
    <p class="text-gray-700 mb-4">Know of other native plant events in the area?</p>
    <a href="mailto:kallen808@gmail.com" class="btn-primary">Email Ken</a>
  </div>
</section>

</PageLayout>
