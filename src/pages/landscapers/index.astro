---
import PageLayout from '../../layouts/PageLayout.astro';
import { getLandscapers } from '../../lib/data';

const landscapers = getLandscapers();
---

<PageLayout title="Landscapers" description="Native plant landscaping companies and services in the DC Metro area.">

<!-- Landscaping Companies -->
<section class="section bg-white">
  <div class="container-narrow">
    <h2 class="section-title flex items-center gap-3">
      <span class="text-3xl">🏡</span> Landscaping Companies That Use Mostly Natives
    </h2>

    <p class="text-gray-600 italic mb-6">I have not vetted any of these. Let me know if you have a particularly good (or bad) experience with any of them.</p>

    <div class="grid gap-4 max-w-3xl">
      {landscapers.map(co => (
        <div class="card">
          <h3 class="font-bold text-green-800">{co.name}</h3>
          {co.url && <a href={co.url} target="_blank" rel="noopener" class="resource-link text-sm">{co.url}</a>}
          {co.phone && <p class="text-gray-600 text-sm mt-1">{co.phone}</p>}
          {co.contactEmail && <p class="text-gray-600 text-sm">{co.contactEmail}</p>}
          {co.address && <p class="text-gray-600 text-sm">{co.address}</p>}
          {co.description && <p class="text-gray-700 mt-2 text-sm">{co.description}</p>}
        </div>
      ))}
    </div>
  </div>
</section>

</PageLayout>
