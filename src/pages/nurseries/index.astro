---
import PageLayout from '../../layouts/PageLayout.astro';
import { nurseries } from '../../lib/data';

const endorsed = nurseries.filter(n => n.isEndorsed);
const others = nurseries.filter(n => !n.isEndorsed).sort((a, b) => a.name.localeCompare(b.name));
---

<PageLayout title="Nurseries" description="Directory of native plant nurseries near the DC Metro area. Find places to buy native plants for your yard.">

<!-- Hero -->
<section class="relative bg-gradient-to-b from-teal-700 to-teal-600 text-white -mt-8 pt-8 pb-12 sm:pb-16 rounded-b-3xl sm:mx-auto max-w-6xl">
  <div class="container-narrow">
    <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-center mb-6">Nurseries</h1>
    <p class="text-xl text-teal-100 text-center max-w-2xl mx-auto">
      Places to find and buy native plants near the DC Metro area.
    </p>
  </div>
</section>

<!-- Nurseries -->
<section class="section bg-white">
  <div class="container-narrow max-w-3xl mx-auto">

    {endorsed.length > 0 && (
      <div class="bg-green-100 border border-green-300 rounded-lg p-4 mb-6">
        <p class="text-green-800 font-medium">The first {endorsed.length} listed sell <strong>only natives</strong> and no cultivars. They all come highly recommended.</p>
      </div>
    )}

    <!-- Endorsed nurseries -->
    {endorsed.length > 0 && (
      <div class="grid gap-6 mb-8">
        {endorsed.map(nursery => (
          <div class="card border-l-4 border-green-500">
            <h3 class="font-bold text-lg text-green-800">{nursery.name}</h3>
            {nursery.phone && <p class="text-gray-600 text-sm">{nursery.phone}</p>}
            {nursery.url && <a href={nursery.url} target="_blank" rel="noopener" class="resource-link text-sm">{nursery.url}</a>}
            {nursery.description && <p class="text-gray-700 mt-2">{nursery.description}</p>}
          </div>
        ))}
      </div>
    )}

    <p class="text-gray-500 italic mb-4">The rest are in alphabetical order, no preference intended.</p>
    <p class="text-gray-600 italic mb-6 text-sm">If there is a specific plant I want, I will put the scientific name plus "for sale" in a search engine to see who has it in stock. &mdash; Ken</p>

    <!-- Full nursery directory -->
    <div class="grid gap-4">
      {others.map(nursery => (
        <div class="nursery-entry">
          <h3 class="font-bold text-green-800">{nursery.name}</h3>
          {nursery.url && <a href={nursery.url} target="_blank" rel="noopener" class="resource-link text-sm">{nursery.url}</a>}
          {nursery.phone && <p class="text-gray-600 text-sm mt-1">{nursery.phone}</p>}
          {nursery.contactEmail && <p class="text-gray-600 text-sm">{nursery.contactEmail}</p>}
          {nursery.address && <p class="text-gray-600 text-sm">{nursery.address}</p>}
          {nursery.notes && <p class="text-gray-700 mt-2 text-sm">{nursery.notes}</p>}
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Contact -->
<section class="section bg-green-50">
  <div class="container-narrow text-center max-w-xl mx-auto">
    <p class="text-gray-700 mb-4">Know of a nursery that should be listed here?</p>
    <a href="mailto:kallen808@gmail.com" class="btn-primary">Email Ken</a>
  </div>
</section>

</PageLayout>
