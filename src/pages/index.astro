---
import PageLayout from '../layouts/PageLayout.astro';
import { getLastUpdated } from '../lib/lastUpdated';
import { organizations } from '../lib/organizations';

const lastUpdated = await getLastUpdated();
---

<PageLayout title="Home" description="Native plant resources for the DC Metro area (DMV). Nurseries, plant swaps, landscaping companies, and everything you need to grow a garden that supports wildlife.">

<!-- Hero Section -->
<section class="relative bg-gradient-to-b from-green-700 to-green-600 text-white -mt-24 pt-24 pb-16 sm:py-20 rounded-b-3xl sm:mx-auto max-w-6xl">
  <div class="container-narrow space-y-8">
    <!-- Welcome text -->
    <div>
      <div class="flex items-center justify-center gap-6">
        <h1 class="text-2xl sm:text-4xl md:text-5xl font-extrabold tracking-tight leading-tight break-words text-center">
          Welcome to<br/>NativePlantsDMV.com
        </h1>
        <div class="flex-shrink-0 flex flex-col items-center text-center" style="margin-bottom: 0.5rem;">
          <a href="https://sites.google.com/view/climateactioncoffee" target="_blank" rel="noopener" class="text-xs sm:text-sm text-green-200 underline font-medium hover:text-white transition-colors"><img src="/logo/climate-action-coffee.png" alt="Climate Action Coffee logo" class="h-24 w-auto rounded"/></a>
        </div>
      </div>
    </div>

    <!-- Artsy photos: butterfly + coreopsis -->
    <div class="flex justify-center gap-4 flex-wrap mb-8">
      <img
        src="/images/butterfly-coneflowers.jpg"
        alt="Eastern Tiger Swallowtail butterfly on pink coneflowers"
        class="rounded-xl shadow-2xl w-full max-w-xs object-cover"
        loading="eager"
      />
      <img
        src="/images/coreopsis-bees.jpg"
        alt="Yellow coreopsis flowers with bees foraging"
        class="rounded-xl shadow-2xl w-full max-w-xs object-cover"
        loading="eager"
      />
    </div>
    <p class="text-center text-green-100 max-w-2xl mt-8 mb-4 mx-auto">
      Your local resource for native plants in the DC metro area — everything you need to grow a garden that supports wildlife and biodiversity, from why natives matter to what's good for your yard, design ideas, and organizations to help.
    </p>

    <!-- Yard signs section -->
    <div class="border-t border-green-500/30 pt-8">
      <div class="flex justify-center mb-4">
        <img
          src="/images/yard-signs-combo.jpg"
          alt="Native Plants yard signs in residential garden"
          class="rounded-xl shadow-2xl w-full max-w-xs object-cover"
          loading="eager"
        />
      </div>
      <div class="text-center">
        <h2 class="text-xl font-bold mb-2">Native Plant Signs Available</h2>
        <p class="text-green-100 mb-2">$5 donation: pick up in Takoma Park, or delivery nearby</p>
        <p class="text-sm text-green-200">
          Contact for more information: <a href="mailto:kallen808@gmail.com" class="underline hover:text-white transition-colors">kallen808@gmail.com</a>
        </p>
      </div>
    </div>
  </div>
</section>

<!-- Why Native Plants -->
<section class="section bg-white">
  <div class="container-narrow">
    <h2 class="section-title flex items-center gap-3">
      <span class="text-3xl">🦋</span> Why Grow Native Plants?
    </h2>
    <ul class="space-y-2 max-w-3xl text-gray-700 list-disc pl-6">
      <li>A single mature native tree can support hundreds of caterpillar species, which feed nesting songbirds.</li>
      <li>Less watering, fewer pesticides — natives evolved for this soil and climate.</li>
      <li>Even small yards contribute to ecological corridors when planted thoughtfully.</li>
    </ul>
    <div class="mt-6">
      <a href="/resources/#why-natives" class="btn-primary inline-block">Read More Resources →</a>
    </div>
    <p class="text-gray-600 mt-4 text-sm">Learn more about our group on the <a href="/about/" class="resource-link">About Us</a> page.</p>
  </div>
</section>
<div class="max-w-3xl mx-auto border-b border-green-200" style="border-width: 2px;"></div>

<!-- Endorsed Nurseries -->
<section class="section bg-stone-50">
  <div class="container-narrow">
    <h2 class="section-title flex items-center gap-3">
      <span class="text-3xl">🌿</span> Our Top Native Nurseries
    </h2>

    <p class="text-gray-600 mb-6 max-w-3xl">These three sell only true natives — no cultivars. All come highly recommended.</p>

    <!-- Top 3 endorsed -->
    <div class="space-y-3 max-w-xl">
      <a href="https://bonaterradc.com" target="_blank" rel="noopener" class="flex items-center gap-3 p-4 rounded-lg bg-white border border-gray-200 hover:border-green-400 transition-colors group">
        <span class="font-semibold text-green-800 group-hover:underline">Bona Terra</span>
        <span class="text-gray-500 text-sm">bonaterradc.com</span>
        <span class="text-gray-400 text-sm italic ml-auto hidden sm:inline">Largest retail native inventory in DC</span>
      </a>
      <a href="http://chesapeakenatives.org" target="_blank" rel="noopener" class="flex items-center gap-3 p-4 rounded-lg bg-white border border-gray-200 hover:border-green-400 transition-colors group">
        <span class="font-semibold text-green-800 group-hover:underline">Chesapeake Natives</span>
        <span class="text-gray-500 text-sm">chesapeakenatives.org</span>
        <span class="text-gray-400 text-sm italic ml-auto hidden sm:inline">Local ecotypes only</span>
      </a>
      <a href="https://www.earthsangha.org/" target="_blank" rel="noopener" class="flex items-center gap-3 p-4 rounded-lg bg-white border border-gray-200 hover:border-green-400 transition-colors group">
        <span class="font-semibold text-green-800 group-hover:underline">Earth Sangha Nursery</span>
        <span class="text-gray-500 text-sm">earthsangha.org</span>
        <span class="text-gray-400 text-sm italic ml-auto hidden sm:inline">DC nonprofit, ecological restoration</span>
      </a>
    </div>

    <div class="text-center mt-8">
      <a href="/nurseries/" class="btn-primary inline-block">See Full Nursery Directory →</a>
    </div>
  </div>
</section>
<div class="max-w-3xl mx-auto border-b border-green-200" style="border-width: 2px;"></div>
<!-- What Native Plants Are Good for Your Yard? -->
<section class="section bg-white">
  <div class="container-narrow">
    <h2 class="section-title text-center">What Native Plants Are Good for Your Yard?</h2>
    <p class="text-gray-600 mb-6 max-w-3xl text-center">Start with these guides to pick the right plants for your space.</p>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-2xl mx-auto mb-8">
      <a href="https://extension.umd.edu/resource/native-plants-shady-slopes" target="_blank" rel="noopener" class="block rounded-lg border border-gray-200 overflow-hidden hover:border-green-400 transition-colors group p-3 bg-stone-50">
        <span class="text-sm font-semibold text-green-800 group-hover:underline block">Native Plants for Shady Slopes</span>
      </a>
      <a href="https://extension.umd.edu/resource/native-plants-sunny-slopes" target="_blank" rel="noopener" class="block rounded-lg border border-gray-200 overflow-hidden hover:border-green-400 transition-colors group p-3 bg-stone-50">
        <span class="text-sm font-semibold text-green-800 group-hover:underline block">Native Plants for Sunny Slopes</span>
      </a>
    </div>
    <div class="text-center">
      <a href="/resources/" class="btn-primary inline-block">View All Resources →</a>
    </div>
  </div>
</section>
<div class="max-w-3xl mx-auto border-b border-green-200" style="border-width: 2px;"></div>
<!-- Free Garden Designs Teaser -->
<section class="section bg-white">
  <div class="container-narrow">
    <h2 class="section-title text-center">Free Garden Designs</h2>
    <p class="text-gray-600 mb-6 max-w-3xl text-center">Ready to plan? These free guides and templates walk you through designing a native garden for your space.</p>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-2xl mx-auto mb-6">
      <a href="https://nativegardendesigns.wildones.org/designs/washington-dc/" target="_blank" rel="noopener" class="block rounded-lg border border-gray-200 overflow-hidden hover:border-green-400 transition-colors group">
        <img src="/images/wild-ones-designs.png" alt="DC area native garden design plan" class="w-full h-auto object-cover aspect-video"/>
        <div class="p-3 bg-stone-50">
          <span class="text-sm font-semibold text-green-800 group-hover:underline block">Wild Ones: DC Area Garden Design</span>
        </div>
      </a>
      <a href="https://www.howardnature.org/wp-content/uploads/2020/05/Native-Plant-Pollinator-Garden-Templates.pdf" target="_blank" rel="noopener" class="block rounded-lg border border-gray-200 overflow-hidden hover:border-green-400 transition-colors group">
        <img src="/images/bumblebee-on-native.png" alt="Bumblebees foraging on Joe-Pye Weed" class="w-full h-auto object-cover aspect-video"/>
        <div class="p-3 bg-stone-50">
          <span class="text-sm font-semibold text-green-800 group-hover:underline block">Howard Nature: Pollinator Garden Templates</span>
        </div>
      </a>
    </div>
    <div class="text-center">
      <a href="/resources/#garden-design" class="btn-primary inline-block">View All Design Resources →</a>
    </div>
  </div>
</section>
<div class="max-w-3xl mx-auto border-b border-green-200" style="border-width: 2px;"></div>
<!-- Organizations Teaser -->
<section class="section bg-white">
  <div class="container-narrow">
    <h2 class="section-title text-center">Organizations That Promote Native Plants</h2>
    <div class="max-w-xl mx-auto">
      <div class="card text-center">
        <h3 class="font-bold text-green-800">{organizations[0].name}</h3>
        <a href={organizations[0].url} target="_blank" rel="noopener" class="resource-link text-sm block mt-1">{organizations[0].url}</a>
        {organizations[0].sub && <p class="text-gray-600 text-xs mt-2">{organizations[0].sub}: <a href={organizations[0].subUrl ?? ''} target="_blank" rel="noopener" class="resource-link">{organizations[0].subUrl}</a></p>}
      </div>
    </div>
    <div class="text-center mt-4">
      <a href="/resources/#organizations" class="btn-primary inline-block">View All Organizations →</a>
    </div>
  </div>
</section>

<!-- Quick Nav to Sub-pages -->
<section class="section bg-green-50">
  <div class="container-narrow">
    <h2 class="section-title text-center">Explore More</h2>
    <nav class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 max-w-4xl mx-auto" aria-label="Site sections">
      {[
        { label: '🚫 Invasives', url: '/invasives/', desc: 'Non-native species to watch for' },
        { label: '🏡 Landscapers', url: '/landscapers/', desc: 'Companies that use mostly natives' },
        { label: '🌳 Gardens to Visit', url: '/gardens-to-visit/', desc: 'Public gardens and arboretums' },
        { label: '📚 Resources', url: '/resources/', desc: 'Plant guides, ID apps, organizations' },
      ].map(item => (
        <a href={item.url} class="bg-white rounded-lg p-4 shadow-sm hover:shadow-md transition-shadow block">
          <h3 class="font-bold text-green-700">{item.label}</h3>
          <p class="text-gray-600 text-sm mt-1">{item.desc}</p>
        </a>
      ))}
    </nav>
  </div>
</section>

<!-- Bottom Contact -->
<section class="section bg-white">
  <div class="container-narrow text-center">
    <p class="text-gray-700 mb-4 text-lg">Know other resources, or corrections needed?</p>
    <a href="mailto:kallen808@gmail.com" class="btn-primary">
      Email Ken &mdash; I'll take care of it soon.
    </a>
    <p class="text-gray-500 text-sm mt-4">Last updated: {lastUpdated}</p>
  </div>
</section>

</PageLayout>
