---
import { getLastUpdated } from '../lib/lastUpdated';

const lastUpdated = await getLastUpdated();
---

<footer class="bg-green-900 text-green-200 mt-auto">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- About -->
      <div>
        <h3 class="text-white font-semibold mb-2">NativePlantsDMV.com</h3>
        <p class="text-sm leading-relaxed">
          Promoting native plants and pollinators in the DC Metro area.
          A project of The Pollinators subgroup at Climate Action Coffee (CAC).
        </p>
      </div>

      <!-- Quick links -->
      <div>
        <h3 class="text-white font-semibold mb-2">Quick Links</h3>
        <ul class="space-y-1 text-sm">
          <li><a href="/" class="hover:text-green-100 transition-colors">Home</a></li>
          <li><a href="/about/" class="hover:text-green-100 transition-colors">About Us</a></li>
          <li><a href="/resources/" class="hover:text-green-100 transition-colors">Resources</a></li>
          <li><a href="/events/" class="hover:text-green-100 transition-colors">Current Events</a></li>
          <li><a href="/invasives/" class="hover:text-green-100 transition-colors">Non-Native Invasives</a></li>
          <li><a href="/gardens-to-visit/" class="hover:text-green-100 transition-colors">Gardens to Visit</a></li>
          <li><a href="/nurseries/" class="hover:text-green-100 transition-colors">Nurseries</a></li>
          <li><a href="/landscapers/" class="hover:text-green-100 transition-colors">Landscapers</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="text-white font-semibold mb-2">Contact</h3>
        <p class="text-sm leading-relaxed">
          Know other resources or corrections needed?
          <br />
          <a href="mailto:kallen808@gmail.com" class="text-green-100 underline hover:text-white transition-colors">Email Ken</a>
        </p>
      </div>
    </div>

    <div class="border-t border-green-800 mt-6 pt-4 text-center text-xs text-green-300">
      Last updated: {lastUpdated} &middot; Content maintained by Ken & The Pollinators group
    </div>
  </div>
</footer>
